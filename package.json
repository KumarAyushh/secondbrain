{
  "name": "secondbrain",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --filter api dev",
    "db:generate": "pnpm --filter @secondbrain/db generate",
    "db:migrate:dev": "pnpm --filter @secondbrain/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @secondbrain/db migrate:deploy",
    "db:migrate:status": "pnpm --filter @secondbrain/db migrate:status"
  }
}
